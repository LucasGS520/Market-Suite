#Ignora repositório Git
.git/
.gitignore

#frontend
node_modules
dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#Ignora Testes
tests/

#Ignora arquivos de configuração de ambiente
.env
.env.*
!.env.*.example
# Arquivos de env do frontend excluídos explicitamente — o build usa --build-arg, não arquivos locais
frontend/.env.frontend
frontend/.env.frontend.*
infra/.env

#Ignora ambientes virtuais
venv*/
.venv/

#Ignora arquivos de log e caches extras
logs/
*.log
.pytest_cache/
.mypy_cache/
.benchmarks/

#Ignora Python cache directories
__pycache__/