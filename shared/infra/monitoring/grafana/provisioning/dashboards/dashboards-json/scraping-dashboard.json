{
  "uid": "marketalert_scraping_latency",
  "title": "Métricas de Scraping – MarketAlert",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "",
  "panels": [
    {
      "id": 1,
      "title": "Pipelines bem-sucedidos por Minuto",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        {
          "expr": "sum(rate(scraper_step_success_total{result=\"success\"}[1m]))",
          "legendFormat": "Sucessos/min",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "colorMode": "value",
        "sparkline": { "show": true }
      }
    },
    {
      "id": 2,
      "title": "Latência média do scraper (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 9 },
      "targets": [
        {
          "expr": "sum(rate(scraping_latency_seconds_sum[5m])) / sum(rate(scraping_latency_seconds_count[5m]))",
          "legendFormat": "Média",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "nullValueMode": "connected"
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "title": "Latência P95 (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 9 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(scraping_latency_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "Fonte: {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "nullValueMode": "connected"
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "title": "Cache hits vs misses (req/min)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(scraper_cache_lookups_total{outcome=\"hit\"}[1m]))",
          "legendFormat": "Hits/min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(scraper_cache_lookups_total{outcome=\"miss\"}[1m]))",
          "legendFormat": "Misses/min",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/min",
          "nullValueMode": "connected"
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "title": "Checagens de robots por minuto",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(scraper_robots_check_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/min",
          "nullValueMode": "connected"
        }
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "Entradas atuais no cache",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 17, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "max(scraper_cache_size)",
          "legendFormat": "Entradas",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    }
  ]
}
